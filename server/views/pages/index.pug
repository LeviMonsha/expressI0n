extends /layouts/main

block content
  .flex.flex-col.items-center.justify-center.min-h-screen.gap-4.p-4
    nav.flex.gap-4.bg-white.p-2.rounded.shadow
      ul.flex.gap-4
        li
          a.flex.items-center.gap-2.px-4.py-2.rounded.hover_bg-gray-100.transition(href="/auth/login")
            svg.w-5.h-5.fill-current(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
              path(d="M10 17l5-5-5-5v10zM4 19h2v-14H4v14z")
            | Войти в аккаунт
        li
          a.flex.items-center.gap-2.px-4.py-2.rounded.hover_bg-gray-100.transition(href="/auth/register")
            svg.w-5.h-5.fill-current(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
              path(d="M19 11h-6V5h-2v6H5v2h6v6h2v-6h6v-2z")
            | Создать аккаунт

    h1.text-3xl.font-bold.text-gray-900 Добро пожаловать!

    if showCookieBanner
      include /partials/cookie-consent.pug
