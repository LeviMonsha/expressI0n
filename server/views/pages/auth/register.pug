extends /layouts/main

block content
  .max-w-md.mx-auto.p-6.bg-white.rounded.shadow
    h2.text-2xl.font-bold.text-center.mb-6 Регистрация

    form#registerForm
      .mb-4
        label.block.mb-1(for="firstName") Имя:
        input#firstName.w-full.border.rounded.px-3.py-2(type="text" name="firstName" placeholder="Иван" required autocomplete="off")

      .mb-4
        label.block.mb-1(for="lastName") Фамилия:
        input#lastName.w-full.border.rounded.px-3.py-2(type="text" name="lastName" placeholder="Иванов" required autocomplete="off")

      .mb-4
        label.block.mb-1(for="username") Имя пользователя:
        input#username.w-full.border.rounded.px-3.py-2(type="text" name="username" placeholder="Ivan" required)

      .mb-4
        label.block.mb-1(for="email") Электронная почта:
        input#email.w-full.border.rounded.px-3.py-2(type="email" name="email" placeholder="ivan@email.com" required)

      .mb-4
        label.block.mb-1(for="password") Пароль:
        input#password.w-full.border.rounded.px-3.py-2(type="password" name="password" placeholder="Pass!word123" required)

      .mb-4
        label.block.mb-1(for="confirmPassword") Подтверждение пароля:
        input#confirmPassword.w-full.border.rounded.px-3.py-2(type="password" name="confirmPassword" placeholder="Повторите пароль" required autocomplete="new-password")

      .mb-4.flex.items-center
        label.flex.items-center.cursor-pointer
          input#isAcceptRules.mr-2(type="checkbox" name="isAcceptRules")
          span Принимаю правила...

      .mb-4
        label.block.mb-1(for="isAdult") Есть 18 лет:
        select#isAdult.w-full.border.rounded.px-3.py-2(name="isAdult" required)
          option(value="") выберите
          option(value="true") Да
          option(value="false") Нет

      .mb-4
        label.block.mb-1 Пол:
        .flex.space-x-6
          label.flex.items-center.cursor-pointer
            input(type="radio" name="gender" value="Мужской" required class="mr-2")
            span Мужской
          label.flex.items-center.cursor-pointer
            input(type="radio" name="gender" value="Женский" required class="mr-2")
            span Женский

      button#submitBtn.w-full.bg-black.text-white.py-2.rounded.hover_bg-gray-700(type="submit") Зарегистрироваться

      div#message.mt-4.text-center.text-red-600